{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "role-requirements-handoff-v1.schema.json",
  "title": "Role Requirements Handoff v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "handoffId", "version", "status", "rolePurpose", "businessContext",
    "outcomes", "decisionRights", "scope", "interfaces", "constraints", "mustHaveCapabilities",
    "trainableCapabilities", "nonRequirements", "successEvidence", "openDecisions", "sources",
    "approvedAt", "approvalAuthority"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "handoffId": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "status": {"enum": ["draft", "review", "approved", "superseded"]},
    "rolePurpose": {"type": "string", "minLength": 1},
    "businessContext": {"type": "string", "minLength": 1},
    "outcomes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "decisionRights": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "scope": {"type": "string", "minLength": 1},
    "interfaces": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "constraints": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "mustHaveCapabilities": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "trainableCapabilities": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "nonRequirements": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "successEvidence": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "openDecisions": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "sources": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "approvedAt": {"type": ["string", "null"]},
    "approvalAuthority": {"type": ["string", "null"]}
  }
}
