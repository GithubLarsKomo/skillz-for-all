{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "capability-model-interpretation-request-v1",
  "type": "object",
  "required": ["schemaVersion", "requestId", "sourceText", "capabilityIndex", "availableCapabilities", "availableOutputs", "responseSchema", "controlRules"],
  "properties": {
    "schemaVersion": {"const": 1},
    "requestId": {"type": "string"},
    "sourceText": {"type": "string"},
    "capabilityIndex": {
      "type": "object",
      "required": ["schemaVersion", "sha256"],
      "properties": {
        "schemaVersion": {"const": 1},
        "sha256": {"type": "string"}
      },
      "additionalProperties": false
    },
    "availableCapabilities": {"type": "array", "items": {"type": "string"}},
    "availableOutputs": {"type": "array", "items": {"type": "string"}},
    "responseSchema": {"const": "capability-model-interpretation-v1"},
    "controlRules": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
