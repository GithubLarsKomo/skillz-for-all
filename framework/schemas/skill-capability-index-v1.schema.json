{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "skill-capability-index-v1",
  "type": "object",
  "required": ["schemaVersion", "skillCount", "entrypointCount", "entrypointCategories", "evaluationSuiteCount", "evaluationPassed", "evaluationErrorCount", "skills"],
  "properties": {
    "schemaVersion": {"const": 1},
    "skillCount": {"type": "integer"},
    "entrypointCount": {"type": "integer"},
    "entrypointCategories": {"type": "array", "items": {"type": "string"}},
    "discoverabilityCounts": {
      "type": "object",
      "properties": {
        "public": {"type": "integer"},
        "advanced": {"type": "integer"},
        "internal": {"type": "integer"},
        "compatibility": {"type": "integer"}
      },
      "additionalProperties": false
    },
    "evaluationSuiteCount": {"type": "integer"},
    "evaluatedSkillCount": {"type": "integer"},
    "evaluatedEntrypointCount": {"type": "integer"},
    "evaluationCoverageComplete": {"type": "boolean"},
    "evaluationPassed": {"type": "boolean"},
    "evaluationErrorCount": {"type": "integer"},
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "description", "invocation", "requires", "dependents", "outputs", "outputContracts", "portableFiles", "evaluation"],
        "properties": {
          "name": {"type": "string"},
          "description": {"type": "string"},
          "invocation": {
            "type": "object",
            "required": ["userFacing", "category"],
            "properties": {
              "userFacing": {"type": "boolean"},
              "category": {"type": ["string", "null"]}
            },
            "additionalProperties": false
          },
          "governance": {
            "type": "object",
            "required": ["status", "discoverability", "replacedBy", "deprecatedSince"],
            "properties": {
              "status": {"type": ["string", "null"]},
              "discoverability": {"enum": ["public", "advanced", "internal", "compatibility"]},
              "replacedBy": {"type": ["string", "null"]},
              "deprecatedSince": {"type": ["string", "null"]}
            },
            "additionalProperties": false
          },
          "requires": {"type": "array", "items": {"type": "string"}},
          "dependents": {"type": "array", "items": {"type": "string"}},
          "outputs": {"type": "array", "items": {"type": "string"}},
          "outputContracts": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["output", "ambiguous", "producers", "consumerSkills"],
              "properties": {
                "output": {"type": "string"},
                "ambiguous": {"type": "boolean"},
                "producers": {"type": "array", "items": {"type": "string"}},
                "consumerSkills": {"type": "array", "items": {"type": "string"}}
              },
              "additionalProperties": false
            }
          },
          "portableFiles": {"type": "array", "items": {"type": "string"}},
          "evaluation": {
            "type": "object",
            "required": ["mode", "caseCount", "recordedResultCount", "passed"],
            "properties": {
              "mode": {"enum": ["rubric", "compatibility", "none"]},
              "caseCount": {"type": "integer"},
              "recordedResultCount": {"type": "integer"},
              "passed": {"type": ["boolean", "null"]}
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
