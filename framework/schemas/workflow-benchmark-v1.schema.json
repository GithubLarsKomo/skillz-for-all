{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "workflow-benchmark-v1",
  "type": "object",
  "required": ["schemaVersion", "suite", "scenarios"],
  "properties": {
    "schemaVersion": {"const": 1},
    "suite": {"type": "string", "minLength": 1},
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "domain", "entrypoint", "intent", "sequence", "mustPreserve", "mustNotDo"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "domain": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "entrypoint": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "intent": {"type": "string", "minLength": 20},
          "sequence": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}
          },
          "mustPreserve": {
            "type": "array",
            "minItems": 2,
            "items": {"type": "string", "minLength": 1}
          },
          "mustNotDo": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
