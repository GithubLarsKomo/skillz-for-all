{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/White Label Maintainer/skillz/schemas/evaluation-rubric.schema.json",
  "title": "Skill evaluation rubric",
  "type": "object",
  "required": ["schemaVersion", "dimensions", "threshold", "blockingCriteria"],
  "properties": {
    "schemaVersion": {"const": 1},
    "dimensions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "weight"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "weight": {"type": "number", "exclusiveMinimum": 0},
          "description": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "threshold": {"type": "number", "minimum": 0, "maximum": 1},
    "blockingCriteria": {
      "type": "array",
      "items": {"enum": ["required-behavior-failed", "forbidden-behavior-observed", "missing-evidence"]},
      "uniqueItems": true
    }
  },
  "additionalProperties": false
}
