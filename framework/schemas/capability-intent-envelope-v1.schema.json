{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "capability-intent-envelope-v1",
  "type": "object",
  "required": ["schemaVersion", "intent", "provenance", "confidence", "review"],
  "properties": {
    "schemaVersion": {"const": 1},
    "intent": {"$ref": "capability-intent-v1.schema.json"},
    "provenance": {
      "type": "object",
      "required": ["producerKind", "producer", "sourceRefs"],
      "properties": {
        "producerKind": {"enum": ["manual", "deterministic", "model"]},
        "producer": {"type": "string"},
        "sourceRefs": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "confidence": {
      "type": "object",
      "required": ["level", "basis"],
      "properties": {
        "level": {"enum": ["asserted", "high", "medium", "low", "unknown"]},
        "basis": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "review": {
      "type": "object",
      "required": ["reviewRequired", "reasons"],
      "properties": {
        "reviewRequired": {"type": "boolean"},
        "reasons": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
