{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "role-architecture-v1.schema.json",
  "title": "Role Architecture v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "roleArchitectureId", "version", "status", "sourceHandoffId", "sourceHandoffVersion",
    "purpose", "outcomes", "accountabilities", "decisionRights", "scope", "interfaces", "context",
    "capabilities", "experienceEvidence", "successMeasures", "nonGoals", "risksAndTensions",
    "approvedAt", "approvalAuthority"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "roleArchitectureId": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "status": {"enum": ["draft", "review", "approved", "superseded"]},
    "sourceHandoffId": {"type": ["string", "null"]},
    "sourceHandoffVersion": {"type": ["string", "null"]},
    "purpose": {"type": "string", "minLength": 1},
    "outcomes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "accountabilities": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "decisionRights": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "scope": {"type": "string", "minLength": 1},
    "interfaces": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "context": {"type": "string", "minLength": 1},
    "capabilities": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "experienceEvidence": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "successMeasures": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "nonGoals": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "risksAndTensions": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "approvedAt": {"type": ["string", "null"]},
    "approvalAuthority": {"type": ["string", "null"]}
  }
}
