{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "memory-candidate-handoff-v1.schema.json",
  "title": "Memory Candidate Handoff v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sourceSkill", "asOf", "candidates", "rejectedRunOnly"],
  "properties": {
    "schemaVersion": {"const": 1},
    "sourceSkill": {"type": "string", "minLength": 1},
    "asOf": {"type": "string", "minLength": 1},
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "statement", "scope", "sourceRefs", "confidence"],
        "properties": {
          "kind": {
            "enum": ["communication-preference", "durable-fact", "durable-constraint", "validated-pattern"]
          },
          "statement": {"type": "string", "minLength": 1},
          "scope": {"type": "string", "minLength": 1},
          "sourceRefs": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "confidence": {"enum": ["high", "medium", "low"]},
          "authorityClass": {
            "enum": ["regulation-law", "standard", "guidance", "organizational-policy", "interpretation", "project-decision", "not-applicable"]
          },
          "observedAt": {"type": ["string", "null"]},
          "reviewAfter": {"type": ["string", "null"]},
          "expiresAt": {"type": ["string", "null"]}
        }
      }
    },
    "rejectedRunOnly": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["reason"],
        "properties": {
          "statement": {"type": ["string", "null"]},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
