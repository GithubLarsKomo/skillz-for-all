{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "capability-model-pipeline-result-v1",
  "title": "Capability model pipeline result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "status", "failedStage", "requestId", "modelRun", "admission", "resolverOutput", "error"],
  "properties": {
    "schemaVersion": {"const": 1},
    "status": {"enum": ["resolved", "failed"]},
    "failedStage": {"anyOf": [{"enum": ["request", "model-run", "review-admission", "deterministic-pipeline"]}, {"type": "null"}]},
    "requestId": {"anyOf": [{"type": "string"}, {"type": "null"}]},
    "modelRun": {"anyOf": [{"type": "object"}, {"type": "null"}]},
    "admission": {"anyOf": [{"type": "object"}, {"type": "null"}]},
    "resolverOutput": {"anyOf": [{"type": "object"}, {"type": "null"}]},
    "error": {"anyOf": [{"type": "string"}, {"type": "null"}]}
  }
}
