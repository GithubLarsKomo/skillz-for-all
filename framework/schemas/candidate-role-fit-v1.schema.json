{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "candidate-role-fit-v1.schema.json",
  "title": "Candidate Role Fit v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "roleArchitectureId", "roleArchitectureVersion", "scoringModelVersion",
    "assessmentStatus", "candidateEvidenceScope", "dimensionAssessments", "verifiedStrengths",
    "evidenceGaps", "contradictions", "knockoutStatus", "overallConfidence",
    "recommendedVerification", "limitations"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "roleArchitectureId": {"type": "string", "minLength": 1},
    "roleArchitectureVersion": {"type": "string", "minLength": 1},
    "scoringModelVersion": {"type": "string", "minLength": 1},
    "assessmentStatus": {"enum": ["current", "stale"]},
    "candidateEvidenceScope": {"type": "string", "minLength": 1},
    "dimensionAssessments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["dimensionId", "evidenceClass", "confidence", "evidence", "assessment", "verificationQuestion"],
        "properties": {
          "dimensionId": {"type": "string", "minLength": 1},
          "evidenceClass": {"enum": ["verified", "supported-inference", "unknown", "contradicted"]},
          "confidence": {"enum": ["high", "medium", "low"]},
          "evidence": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "assessment": {"type": "string", "minLength": 1},
          "verificationQuestion": {"type": ["string", "null"]}
        }
      }
    },
    "verifiedStrengths": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "evidenceGaps": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "contradictions": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "knockoutStatus": {"enum": ["clear", "triggered", "unknown"]},
    "overallConfidence": {"enum": ["high", "medium", "low"]},
    "recommendedVerification": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}}
  }
}
