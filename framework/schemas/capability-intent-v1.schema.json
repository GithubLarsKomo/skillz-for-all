{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "capability-intent-v1",
  "type": "object",
  "required": ["schemaVersion"],
  "properties": {
    "schemaVersion": {"const": 1},
    "desiredOutputs": {"type": "array", "items": {"type": "string"}},
    "requiredDependencies": {"type": "array", "items": {"type": "string"}},
    "allowedEvaluationModes": {"type": "array", "items": {"enum": ["rubric", "compatibility", "none"]}},
    "portableFiles": {"enum": ["required", "forbidden", "irrelevant"]}
  },
  "additionalProperties": false
}
