{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "capability-model-run-result-v1",
  "title": "Capability model run result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "requestId", "provider", "status", "proposal", "adapterCompatible", "validationError", "benchmarkFinding"],
  "properties": {
    "schemaVersion": {"const": 1},
    "requestId": {"type": "string"},
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": {"const": "fixture"},
        "id": {"type": "string"}
      }
    },
    "status": {"enum": ["accepted", "rejected"]},
    "proposal": {"anyOf": [{"type": "object"}, {"type": "null"}]},
    "adapterCompatible": {"type": "boolean"},
    "validationError": {"anyOf": [{"type": "string"}, {"type": "null"}]},
    "benchmarkFinding": {"anyOf": [{"type": "object"}, {"type": "null"}]}
  }
}
